# ======================================
# File .env
# Digunakan oleh docker-compose & script
# ======================================

# Username Docker Hub (ubah sesuai akun kamu)
DOCKERHUB_USERNAME=andikaferdialvianto

# Tag image untuk item-app
ITEM_APP_TAG=v1

# Nama image lokal (tanpa username)
ITEM_APP_LOCAL=item-app

# Versi MongoDB (sesuai kriteria: 3)
MONGO_VERSION=3
